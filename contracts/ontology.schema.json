{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:headstart:ontology:0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["ontology_version", "concepts", "migrations", "changelog"],
  "properties": {
    "ontology_version": {"const": "0.2"},
    "concepts": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "facet", "parent_id", "aliases", "deprecated_by"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "facet": {"enum": ["genre", "capability", "style", "runtime", "authoring_tool", "platform", "input", "physics", "camera"]},
        "parent_id": {"type": ["string", "null"]},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "deprecated_by": {"type": ["string", "null"]}
      }
    }},
    "migrations": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["from_version", "from_id", "to_id", "reason"],
      "properties": {"from_version": {"type": "string"}, "from_id": {"type": "string"}, "to_id": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}
    }},
    "changelog": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "change"],
      "properties": {"version": {"type": "string"}, "change": {"type": "string", "minLength": 1}}
    }}
  }
}
