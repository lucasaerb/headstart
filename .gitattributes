# Preserve supplied document/image/archive bytes and avoid text diff heuristics.
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.zip binary
*.sqlite binary

# Python CSV exports use standard CRLF record terminators.
research/catalog/catalog.csv whitespace=cr-at-eol

# Large walkthrough and site media added after the initial release.
HeadStartDemo.mp4 filter=lfs diff=lfs merge=lfs -text
headstart-walkthrough/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
headstart-walkthrough/**/*.m4a filter=lfs diff=lfs merge=lfs -text
HeadStart-Starter-Package/site/dist/assets/how-it-works.mp4 filter=lfs diff=lfs merge=lfs -text
